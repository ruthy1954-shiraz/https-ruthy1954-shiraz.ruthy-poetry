<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>27-08-2024 חמלה שמרפאה את הלב ואת העולם</title>
    <link rel="stylesheet" href="tikshurim.css">
</head>

<body>

<div class="wrapper">

    <!-- תמונת פתיחה -->
    <div class="song-image">
        <img src="images/or_haela.jpeg" alt="אור האלה">
    </div>

    <h1 class="song-title">27-08-2024</h1>
    <h2 class="song-author">חמלה שמרפאה את הלב ואת העולם</h2>

    <div class="song-box">
        <p>
            כאן אור האלה ממלכת האור האלוהי  
            נמצאת כאן להראות לכם את הדרך אל האור.  
            הימים הם ימי חושך.  
            אתם מתבקשים כדי לחיות — לגלות את האור שבתוככם  
            על מנת להציל אתכם, את יושבי ארצכם ואת העולם  
            מלהישאר בחושך.
        </p>

        <a id="moreBtn" class="more-link">...</a>

        <div id="moreText" class="hidden" style="margin-top:15px;">
            <p>
                ומהו האור שאנו מבקשים מכם להפיץ?
                <br><br>
                זהו אור  
                הממיס את הפחד,  
                את האי־ודאות,  
                את הרצון העז של השליטים למלחמה  
                באמצעות הפחד לשלוט בכם.
                <br><br>
                זהו אור  
                המביא חמלה  
                לעמכם,  
                לביתכם,  
                לארצכם,  
                לעולם  
                וליקום כולו.
                <br><br>
                אור המביא החלמה  
                ללב שלכם,  
                לכל אשר חי ומתקיים  
                סביבכם,  
                בארצכם,  
                בעולם  
                וביקום.
                <br><br>
                הימים הם ימים של מלחמת האור בחושך.  
                ימים של בריאה.  
                ימים של הבנה שכדי להביא שינוי עמוק  
                חייבים לעבור דרך החושך — דרך הפחד —  
                ולהתגבר, כדי להגיע אל האור.
                <br><br>
                בחושך מתקיימות המזימות,  
                השתלטנות,  
                החמסנות,  
                הרוע  
                וכל מרעין בישין.
                <br><br>
                החמלה, האהבה, ההתחשבות,  
                האמונה בטוב האדם —  
                מתקיימות באור.
                <br><br>
                כן —  
                תגבירו את האור בכם!  
                כן —  
                תקטינו את החושך והאי־ודאות  
                השורר בכם ובעולם כולו.
                <br><br>
                שימו לב שישנן נפשות —  
                הן הולכות וגדלות —  
                אשר הכאב והמשבר שחוו  
                מביאים אותן למעשי חמלה וחסד.  
                הן עברו את מחסום הייאוש והפחד.  
                הן באור!
                <br><br>
                אתם לא חייבים לחוות עוד כאב  
                כדי להבין שרק החסד והרחמים  
                לעצמכם ולאחר —  
                זו הדרך אל האור,  
                אל האהבה  
                במובן הרחב, המדויק והשלם.
                <br><br>
                היו בשלום — ויהיה שלם ושלום!
                <br><br>
                כאן אור האלה ממלכת האור האלוהי  
                מברכת אתכם בימים של אור ותקווה.
            </p>
        </div>
    </div>

    <!-- כפתור הערות -->
    <button class="toggle-notes">הערות והארות</button>

    <!-- תיבת הערות -->
    <div class="notes-box hidden">
        <h3>כתיבת הערות והארות</h3>

        <input id="userName" placeholder="השם שלכם..." />
        <input id="userSong" placeholder="שם התקשור..." value="חמלה שמרפאה את הלב ואת העולם" />
        <textarea id="userNote" placeholder="כתבו כאן את מחשבותיכם על התקשור..."></textarea>

        <div class="footer-nav" style="margin-top:15px;">
            <a id="waLink">ווצאפ לכותבת</a> |
            <a id="saveLink">שמירת הערה</a>
        </div>

        <h4>הערות קוראים שנשמרו:</h4>
        <div id="notes"></div>
    </div>

    <!-- ניווט -->
    <div class="footer-nav">
        <a href="../../index.html">עמוד ראשי</a> |
        <a href="tikshurim-list.html">חזרה לרשימת התקשורים</a>
    </div>

    <!-- כפתור שיתוף -->
    <button class="share-btn" onclick="shareTikshur()">שתפו את התקשור</button>

</div>

<script>
    var tikId = "27-08-2024";
</script>

<script type="module">
    import { initTikshurimNotes, saveTikshurimNote, deleteTikshurimNote } from "./notes-tikshurim.js";

    initTikshurimNotes(tikId);

    const waLink = document.getElementById("waLink");
    const saveLink = document.getElementById("saveLink");
    const phone = "972545305123";

    waLink.addEventListener("click", function() {
        const name = document.getElementById("userName").value.trim();
        const song = document.getElementById("userSong").value.trim();
        const note = document.getElementById("userNote").value.trim();

        const message =
            `שם הכותב: ${name}\n` +
            `שם התקשור: ${song}\n` +
            `הערה: ${note}`;

        const encoded = encodeURIComponent(message);
        window.open(`https://wa.me/${phone}?text=${encoded}`, "_blank");
    });

    saveLink.addEventListener("click", async function() {
        const name = document.getElementById("userName").value.trim();
        const song = document.getElementById("userSong").value.trim();
        const note = document.getElementById("userNote").value.trim();

        const saved = await saveTikshurimNote(name, song, note, tikId);

        if (saved) {
            const card = document.createElement("div");
            card.className = "note-card";
            card.innerHTML = `
                <strong>${saved.name}</strong><br>
                ${saved.note}<br>
                <span class="note-date">${saved.date}</span>
                <button class="delete-btn" data-id="${saved.id}">✖</button>
            `;
            document.getElementById("notes").prepend(card);
        }

        document.getElementById("userNote").value = "";
    });

    document.addEventListener("click", async (e) => {
        if (e.target.classList.contains("delete-btn")) {
            const noteId = e.target.dataset.id;
            await deleteTikshurimNote(noteId, tikId);
            e.target.closest(".note-card").remove();
        }
    });
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const toggleBtn = document.querySelector(".toggle-notes");
    const notesBox = document.querySelector(".notes-box");
    const moreBtn = document.getElementById("moreBtn");
    const moreText = document.getElementById("moreText");

    moreBtn.addEventListener("click", () => {
        moreText.classList.remove("hidden");
        moreBtn.style.display = "none";
    });

    toggleBtn.addEventListener("click", () => {
        notesBox.classList.toggle("hidden");
        toggleBtn.textContent = notesBox.classList.contains("hidden")
            ? "הערות והארות"
            : "הסתרת הערות";
    });
});
</script>

<script>
function shareTikshur() {
    if (navigator.share) {
        navigator.share({
            title: document.title,
            text: "רציתי לשתף את התקשור הזה:",
            url: window.location.href
        });
    } else {
        alert("הדפדפן לא תומך בשיתוף אוטומטי");
    }
}
</script>

</body>
</html>
